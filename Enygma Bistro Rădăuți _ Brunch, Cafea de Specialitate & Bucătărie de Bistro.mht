.contact-card .detail-label { color: var(--muted-light); margin-bottom: 0px; }

.contact-card p { color: var(--paper); font-size: 16px; }

.contact-card .phone-big { font-family: var(--font-display); font-size: 28px; letter-spacing: -0.01em; }

.contact-card a { font-size: 14px; font-weight: 600; color: var(--caramel); text-decoration: none; }

.contact-card a:hover { text-decoration: underline; text-underline-offset: 4px; }

.reserve { max-width: var(--wrap); margin: 0px auto; padding: clamp(80px, 10vw, 140px) var(--gutter); display: grid; grid-template-columns: 4fr 6fr; gap: clamp(36px, 6vw, 80px); align-items: start; }

.reserve-intro { position: sticky; top: 110px; }

.reserve-intro .section-title { margin-bottom: 20px; }

.reserve-intro p { color: var(--muted); font-size: 17px; margin-bottom: 28px; }

.reserve-phone { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; font-family: var(--font-display); font-size: clamp(26px, 3vw, 34px); color: var(--espresso); border-bottom: 1px solid var(--accent); padding-bottom: 4px; transition: color 0.25s; }

.reserve-phone svg { width: 26px; height: 26px; color: var(--accent); }

.reserve-phone:hover { color: var(--accent); }

.reserve-form { background: var(--paper); border: 1px solid var(--border); border-radius: 28px; padding: clamp(24px, 4vw, 44px); display: grid; grid-template-columns: 1fr 1fr; gap: 20px 18px; box-shadow: rgba(35, 26, 20, 0.5) 0px 40px 70px -50px; }

.hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

.field { display: grid; gap: 7px; align-content: start; border: 0px; min-width: 0px; }

.field-wide { grid-column: 1 / -1; }

.field label, .field legend { font-size: 13px; font-weight: 600; color: var(--espresso); }

.field small { font-weight: 400; color: var(--muted); }

.field input, .field textarea { width: 100%; padding: 13px 15px; border-radius: 12px; background: var(--cream); border: 1px solid var(--border); font-size: 16px; transition: border-color 0.2s, background-color 0.2s, box-shadow 0.2s; }

.field textarea { resize: vertical; min-height: 92px; }

.field input::placeholder, .field textarea::placeholder { color: rgb(169, 156, 140); }

.field input:hover, .field textarea:hover { border-color: rgb(210, 195, 176); }

.field input:focus, .field textarea:focus { outline: none; background: rgb(255, 255, 255); border-color: var(--accent); box-shadow: rgba(140, 88, 58, 0.14) 0px 0px 0px 4px; }

.field.has-error input { border-color: var(--danger); background: rgb(251, 241, 238); }

.field-error { font-size: 13px; color: var(--danger); min-height: 0px; }

.field-error:empty { display: none; }

.guests legend { margin-bottom: 9px; }

.guest-options { display: flex; flex-wrap: wrap; gap: 8px; }

.guest-options label { cursor: pointer; }

.guest-options input { position: absolute; opacity: 0; pointer-events: none; }

.guest-options span { display: grid; place-items: center; min-width: 52px; height: 46px; padding: 0px 14px; border-radius: 12px; border: 1px solid var(--border); background: var(--cream); font-weight: 600; font-variant-numeric: tabular-nums; transition: background-color .2s, color .2s, border-color .2s, transform .2s var(--ease); }

.guest-options label:hover span { border-color: var(--accent); }

.guest-options input:checked + span { background: var(--espresso); color: var(--paper); border-color: var(--espresso); transform: translateY(-2px); }

.guest-options input:focus-visible + span { outline: 2px solid var(--caramel); outline-offset: 2px; }

.form-footer { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; margin-top: 6px; }

.form-hint { font-size: 13px; color: var(--muted); flex: 1 1 0%; min-width: 200px; }

.btn-submit { position: relative; min-width: 220px; }

.btn-spinner { display: none; width: 18px; height: 18px; border-radius: 50%; border-width: 2px; border-style: solid; border-right-color: rgba(251, 247, 241, 0.35); border-bottom-color: rgba(251, 247, 241, 0.35); border-left-color: rgba(251, 247, 241, 0.35); border-image: none; border-top-color: var(--paper); animation: 0.8s linear 0s infinite normal none running spin; }

.reserve-form.is-sending .btn-spinner { display: inline-block; }

.reserve-form.is-sending .btn-submit { pointer-events: none; opacity: 0.85; }

.form-alert { grid-column: 1 / -1; border-radius: 16px; padding: 18px 20px; font-size: 15px; }

.form-alert.is-error { background: rgb(251, 234, 230); color: rgb(122, 42, 30); border: 1px solid rgb(239, 201, 192); }

.form-alert a { font-weight: 700; }

.form-success { grid-column: 1 / -1; text-align: center; padding: clamp(20px, 4vw, 40px) 10px; animation: rise .6s var(--ease) both; }

.form-success svg { width: 64px; height: 64px; margin: 0px auto 20px; color: var(--ok); }

.form-success h3 { font-family: var(--font-display); font-weight: 400; font-size: 32px; color: var(--espresso); margin-bottom: 10px; }

.form-success p { color: var(--muted); max-width: 380px; margin: 0px auto 22px; }

.site-footer { background: var(--espresso); color: var(--muted-light); padding: clamp(56px, 7vw, 90px) var(--gutter) 32px; }

.footer-top, .footer-bottom { max-width: var(--wrap); margin: 0px auto; }

.footer-top { display: grid; grid-template-columns: 1fr 1.4fr; gap: 48px; padding-bottom: 44px; border-bottom: 1px solid var(--border-dark); }

.footer-logo { font-family: var(--font-display); font-size: clamp(40px, 6vw, 72px); font-weight: 500; color: var(--paper); letter-spacing: -0.02em; line-height: 1; display: block; margin-bottom: 16px; }

.footer-brand p { max-width: 320px; }

.footer-cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }

.footer-cols .detail-label { color: var(--caramel); }

.footer-cols p { color: var(--accent-soft); line-height: 1.9; }

.footer-cols a { text-decoration: none; }

.footer-cols a:hover { color: var(--caramel); }

.footer-bottom { display: flex; justify-content: space-between; gap: 16px; padding-top: 24px; font-size: 13px; }

.footer-bottom a { text-decoration: none; }

.footer-bottom a:hover { color: var(--paper); }

.bottom-bar { position: fixed; left: 12px; right: 12px; bottom: 12px; z-index: 90; display: none; gap: 8px; padding: 8px; background: rgba(251, 247, 241, 0.9); backdrop-filter: blur(14px); border: 1px solid var(--border); border-radius: 999px; box-shadow: rgba(35, 26, 20, 0.45) 0px 16px 36px -16px; transform: translateY(140%); transition: transform .45s var(--ease); }

.bottom-bar.is-visible { transform: none; }

.bottom-bar .btn { flex: 1 1 0%; padding: 12px; }

.js .reveal { opacity: 0; transform: translateY(22px); }

.js .is-loaded .reveal, .js body.is-loaded .reveal { animation-duration: ; animation-timing-function: ; animation-iteration-count: ; animation-direction: ; animation-fill-mode: ; animation-play-state: ; animation-name: ; animation-timeline: ; animation-range-start: ; animation-range-end: ; animation-delay: calc(var(--d, 0) * 90ms); }

.on-scroll { opacity: 0; transform: translateY(30px); transition: opacity .9s var(--ease), transform .9s var(--ease); }

.on-scroll.is-in { opacity: 1; transform: none; }

@keyframes rise { 
  0% { opacity: 0; transform: translateY(22px); }
  100% { opacity: 1; transform: none; }
}

@keyframes spin { 
  100% { transform: rotate(360deg); }
}

.art-noon .plate { animation-name: spin-centered; }

@keyframes spin-centered { 
  0% { transform: translateY(-50%) rotate(0deg); }
  100% { transform: translateY(-50%) rotate(360deg); }
}

@keyframes float { 
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-10px); }
}

@keyframes drift { 
  0%, 100% { transform: rotate(-4deg); }
  50% { transform: rotate(4deg); }
}

@keyframes steam { 
  0% { opacity: 0; transform: translateY(20px) scaleX(1); }
  30% { opacity: 0.9; }
  100% { opacity: 0; transform: translateY(-50px) scaleX(1.8); }
}

@keyframes pulse { 
  0% { transform: scale(0.6); opacity: 1; }
  100% { transform: scale(1.8); opacity: 0; }
}

@keyframes marquee { 
  100% { transform: translateX(-50%); }
}

@media (max-width: 960px) {
  .hero { grid-template-columns: 1fr; }
  .hero-art { width: min(86%, 400px); margin-top: 20px; }
  .story { grid-template-columns: 1fr; }
  .menu-head { grid-template-columns: 1fr; }
  .menu-note { justify-self: start; }
  .panel { grid-template-columns: 1fr; }
  .moment, .moment-flip { grid-template-columns: 1fr; gap: 24px; }
  .moment-flip .moment-art { order: 0; }
  .visit { grid-template-columns: 1fr; }
  .reserve { grid-template-columns: 1fr; }
  .reserve-intro { position: static; }
  .footer-top { grid-template-columns: 1fr; }
}

@media (max-width: 820px) {
  .nav-toggle { display: block; }
  .nav-links { position: fixed; inset: 72px 0px auto; z-index: 99; flex-direction: column; align-items: stretch; gap: 0px; background: var(--cream); border-bottom: 1px solid var(--border); padding: 8px var(--gutter) 24px; opacity: 0; transform: translateY(-12px); pointer-events: none; visibility: hidden; transition: opacity .3s var(--ease), transform .3s var(--ease), visibility 0s .3s; }
  .nav-links.is-open { opacity: 1; transform: none; pointer-events: auto; visibility: visible; transition-delay: 0s; }
  .nav-links a:not(.btn) { font-family: var(--font-display); font-size: 26px; padding: 12px 0px; border-bottom: 1px solid var(--border); }
  .nav-links a:not(.btn)::after { display: none; }
  .nav-cta { margin-top: 20px; padding: 14px; font-size: 16px; }
  .bottom-bar { display: flex; }
  body { padding-bottom: 80px; }
}

@media (max-width: 560px) {
  .hero-card { left: -14px; bottom: 18px; max-width: 210px; padding: 12px 16px; }
  .hero-card strong { font-size: 16px; }
  .badge { width: 100px; top: -20px; right: -16px; }
  .story-facts { grid-template-columns: 1fr; }
  .story-facts li + li { padding-left: 0px; border-left: 0px; border-top: 1px solid var(--border); padding-bottom: 16px; }
  .story-facts li { padding: 16px 0px; }
  .tabs { border-radius: 20px; }
  .tabs button { padding: 9px 14px; font-size: 14px; }
  .dish { grid-template-columns: auto 1fr; }
  .dish .tag { grid-column: 2; justify-self: start; }
  .contact-cards { grid-template-columns: 1fr; }
  .reserve-form { grid-template-columns: 1fr; }
  .footer-cols { grid-template-columns: 1fr 1fr; }
  .footer-bottom { flex-direction: column; }
}

@media (prefers-reduced-motion: reduce) {
  *, ::before, ::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
  html { scroll-behavior: auto; }
  .js .reveal, .on-scroll { opacity: 1; transform: none; }
}
